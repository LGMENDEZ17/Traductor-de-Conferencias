{
  "manifest_version": 3,
  "name": "Traductor de Reuniones en Tiempo Real",
  "version": "0.1.0",
  "description": "Traduce en tiempo real la voz en reuniones de Google Meet, Microsoft Teams y Zoom (versión web), en las dos direcciones.",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://*.zoom.us/*",
    "https://api.deepgram.com/*",
    "https://api.mymemory.translated.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Traductor de Reuniones"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://*.zoom.us/*"
      ],
      "js": ["langs.js", "content.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://*.zoom.us/*"
      ],
      "js": ["injected-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
